    "\n",
    "# PROGRAM 2: MENGHITUNG LUAS BANGUN DATAR\n",
    "\n",
    "# 1. Luas Persegi\n",
    "panjang_sisi = 20\n",
    "luas_persegi = panjang_sisi * panjang_sisi\n",
    "\n",
    "# 2. Luas Persegi Panjang\n",
    "panjang_pp = 50\n",
    "lebar_pp = 25.5\n",
    "luas_pp = panjang_pp * lebar_pp\n",
    "\n",
    "# 3. Luas Segitiga\n",
    "alas_segitiga = 40\n",
    "tinggi_segitiga = 60\n",
    "luas_segitiga = 0.5 * alas_segitiga * tinggi_segitiga\n",
    "\n",
    "# 4. Luas Lingkaran\n",
    "jari_jari = 7\n",
    "luas_lingkaran = 3.14 * jari_jari * jari_jari\n",
    "\n",
    "# 5. Luas Jajaran Genjang\n",
    "alas_jajargenjang = 30\n",
    "tinggi_jajargenjang = 15\n",
    "luas_jajargenjang = alas_jajargenjang * tinggi_jajargenjang\n",
    "\n",
    "# 6. Luas Trapesium\n",
    "sisi_atas = 20\n",
    "sisi_bawah = 30\n",
    "tinggi_trapesium = 10\n",
    "luas_trapesium = 0.5 * (sisi_atas + sisi_bawah) * tinggi_trapesium\n",
    "\n",
    "# Menampilkan hasil\n",
    "print(\"Luas Persegi =\", luas_persegi)\n",
