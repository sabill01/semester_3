    "print(\"Luas Segitiga =\", luas_segitiga)\n",
    "print(\"Luas Lingkaran =\", luas_lingkaran)\n",
    "print(\"Luas Jajaran Genjang =\", luas_jajargenjang)\n",
    "print(\"Luas Trapesium =\", luas_trapesium)\n"
   ]
