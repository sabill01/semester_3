   "source": [
    "\n",
    "# LATIHAN 2: PENJUMLAHAN DUA MATRIKS\n",
    "\n",
    "baris = int(input(\"Masukkan jumlah baris: \"))\n",
    "kolom = int(input(\"Masukkan jumlah kolom: \"))\n",
    "\n",
    "matriks_a = []\n",
    "matriks_b = []\n",
    "hasil = []\n",
    "\n",
    "print(\"\\nMasukkan elemen matriks A:\")\n",
    "for i in range(baris):\n",
    "    baris_data = []\n",
    "    for j in range(kolom):\n",
    "        nilai = int(input(f\"A[{i}][{j}]: \"))\n",
    "        baris_data.append(nilai)\n",
    "    matriks_a.append(baris_data)\n",
    "\n",
    "print(\"\\nMasukkan elemen matriks B:\")\n",
    "for i in range(baris):\n",
    "    baris_data = []\n",
    "    for j in range(kolom):\n",
    "        nilai = int(input(f\"B[{i}][{j}]: \"))\n",
    "        baris_data.append(nilai)\n",
    "    matriks_b.append(baris_data)\n",
    "\n",
    "# Proses penjumlahan matriks\n",
    "for i in range(baris):\n",
    "    baris_hasil = []\n",
    "    for j in range(kolom):\n",
    "        baris_hasil.append(matriks_a[i][j] + matriks_b[i][j])\n",
    "    hasil.append(baris_hasil)\n",
    "\n",
    "print(\"\\nHasil Penjumlahan Matriks:\")\n",
    "for baris_hasil in hasil:\n",
    "    print(baris_hasil)\n"
   ]
