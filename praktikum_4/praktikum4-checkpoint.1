    "\n",
    "# LATIHAN 1: PERULANGAN RANGE DENGAN PENCACAH 3\n",
    "\n",
    "awal = int(input(\"Masukkan bilangan awal: \"))\n",
    "akhir = int(input(\"Masukkan bilangan akhir: \"))\n",
    "\n",
    "perkalian = 1\n",
    "\n",
    "print(\"Bilangan yang ditampilkan:\")\n",
    "\n",
    "for i in range(awal, akhir + 1, 3):\n",
    "    print(i, end=\" \")\n",
    "    perkalian *= i\n",
    "\n",
    "print(\"\\nHasil perkalian semua bilangan =\", perkalian)\n"
   ]
