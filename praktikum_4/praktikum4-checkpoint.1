    "\n",
    "# LATIHAN 4: MENGHITUNG BILANGAN GENAP DAN GANJIL\n",
    "\n",
    "n = int(input(\"Masukkan banyak bilangan: \"))\n",
    "\n",
    "genap = 0\n",
    "ganjil = 0\n",
    "\n",
    "for i in range(n):\n",
    "    bilangan = int(input(f\"Masukkan bilangan ke-{i + 1}: \"))\n",
    "\n",
    "    if bilangan % 2 == 0:\n",
    "        genap += 1\n",
    "    else:\n",
    "        ganjil += 1\n",
    "\n",
    "print(\"\\nJumlah bilangan genap =\", genap)\n",
    "print(\"Jumlah bilangan ganjil =\", ganjil)\n"
   ]
