   "source": [
    "\n",
    "# Program 2: Menghitung Luas Bangun Datar\n",
    "\n",
    "# 1. Luas Persegi\n",
    "panjang_sisi = 20\n",
    "luas_persegi = panjang_sisi * panjang_sisi\n",
    "\n",
    "# 2. Luas Persegi Panjang\n",
    "panjang_pp = 50\n",
    "lebar_pp = 25.5\n",
    "luas_pp = panjang_pp * lebar_pp\n",
    "\n",
    "# 3. Luas Segitiga\n",
    "alas_segitiga = 40\n",
    "tinggi_segitiga = 60\n",
    "luas_segitiga = 0.5 * alas_segitiga * tinggi_segitiga\n",
    "\n",
    "# 4. Luas Lingkaran\n",
    "jari_jari = 14\n",
    "luas_lingkaran = 3.14 * jari_jari * jari_jari\n",
    "\n",
    "# 5. Luas Jajaran Genjang\n",
    "alas_jg = 30\n",
    "tinggi_jg = 20\n",
    "luas_jg = alas_jg * tinggi_jg\n",
    "\n",
    "# 6. Luas Trapesium\n",
    "sisi_atas = 20\n",
    "sisi_bawah = 40\n",
    "tinggi_trapesium = 15\n",
    "luas_trapesium = 0.5 * (sisi_atas + sisi_bawah) * tinggi_trapesium\n",
    "\n",
    "# Menampilkan Hasil\n",
    "print(\"Luas Persegi =\", luas_persegi)\n",
    "print(\"Luas Persegi Panjang =\", luas_pp)\n",
    "print(\"Luas Segitiga =\", luas_segitiga)\n",
    "print(\"Luas Lingkaran =\", luas_lingkaran)\n",
    "print(\"Luas Jajaran Genjang =\", luas_jg)\n",
    "print(\"Luas Trapesium =\", luas_trapesium)\n"
   ]
