   "source": [
    "def caesar_cipher(teks, geser):\n",
    "    hasil = \"\"\n",
    "\n",
    "    for huruf in teks:\n",
    "        if huruf.isupper():\n",
    "            hasil += chr((ord(huruf) - 65 + geser) % 26 + 65)\n",
    "        elif huruf.islower():\n",
    "            hasil += chr((ord(huruf) - 97 + geser) % 26 + 97)\n",
    "        else:\n",
    "            hasil += huruf\n",
    "\n",
    "    return hasil\n",
    "\n",
    "\n",
    "teks = input(\"Masukkan pesan: \")\n",
    "geser = int(input(\"Masukkan jumlah pergeseran: \"))\n",
    "\n",
    "enkripsi = caesar_cipher(teks, geser)\n",
    "\n",
    "print(\"Pesan asli:\", teks)\n",
    "print(\"Hasil enkripsi:\", enkripsi)"
   ]
